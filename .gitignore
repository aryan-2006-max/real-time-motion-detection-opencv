# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# Video media files (do not commit large binaries to git)
*.mp4
*.avi
*.mov
*.mkv
*.webm

# Uploaded and generated processing files
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep

# IDE & OS
.vscode/
.idea/
Thumbs.db
.DS_Store
